# optional, validated in src/lib/env.ts (defaults shown)
NODE_ENV=development
PORT=4000

PG_HOST=localhost
PG_PORT=5432
PG_USER='...'
PG_DATABASE='...'
PG_PASSWORD='...'
STATS_TOKEN='...'
