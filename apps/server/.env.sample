# optional, validated in src/lib/env.ts (defaults shown)
NODE_ENV=development
PORT=4000

PG_HOST=localhost
PG_PORT=5432
PG_USER='...'
PG_DATABASE='...'
PG_PASSWORD='...'
STATS_TOKEN='...'
SUPABASE_URL='...'
SUPABASE_SECRET_KEY='...'

# lets a user switch to Pro without paying; keep unset/false in production
ENABLE_SELF_SERVE_PLAN_SWITCH=true

# only needed for seeding, not required for normal operation
SEED_USER_ID='...'
