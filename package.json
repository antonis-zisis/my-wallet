{
  "name": "my-wallet",
  "version": "0.7.3",
  "type": "module",
  "private": true,
  "author": "Antonis Zisis",
  "description": "A personal budgeting app.",
  "license": "Elastic-2.0",
  "scripts": {
    "dev": "pnpm run --parallel dev",
    "dev:web": "pnpm --filter my-wallet-web dev",
    "dev:server": "pnpm --filter my-wallet-server dev",
    "build": "pnpm run --parallel build",
    "test": "pnpm run --parallel test",
    "lint": "pnpm run --parallel lint",
    "typecheck": "pnpm run --parallel typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "prepare": "husky",
    "env:encrypt": "./scripts/encrypt-envs.sh",
    "env:decrypt": "./scripts/decrypt-envs.sh",
    "db:bootstrap": "./scripts/bootstrap-db.sh",
    "db:bootstrap:docker": "./scripts/bootstrap-db-docker.sh"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "eslint": "^10.7.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-sort-destructure-keys": "^3.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.5",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0"
  },
  "packageManager": "pnpm@11.13.1",
  "volta": {
    "node": "24.18.0"
  }
}
